# Postgres
DATABASE_URL="postgresql://neo_merz:neo_merz@localhost:5432/neo_merz?schema=public"

# Redis (лимиты рекламы, лидерборды, сессии)
REDIS_URL="redis://localhost:6379"

# Telegram
TELEGRAM_BOT_TOKEN="123456:REPLACE_ME"

# AdsGram — если доступен серверный postback/webhook, укажите секрет для проверки подписи
ADSGRAM_WEBHOOK_SECRET="REPLACE_ME"

# HTTP
PORT=3000
CORS_ORIGIN="https://your-mini-app-domain.example"

# Лимиты рекламы — значения ПО УМОЛЧАНИЮ, используются только для первого посева
# (npm run seed) таблицы AdSettings. После этого реальные лимиты живут в БД и
# редактируются из админ-панели ("Настройка рекламных лимитов") без деплоя —
# см. backend/src/modules/ads/adSettingsService.ts.
AD_COIN_REWARD_DAILY_LIMIT=15
AD_COIN_REWARD_AMOUNT=50
AD_BONUS_CHEST_COOLDOWN_HOURS=3

# Админ-панель (Этап 5/6, раздел 5 ТЗ)
# Секрет для подписи JWT сессии админа. ОБЯЗАТЕЛЬНО сгенерировать длинную
# случайную строку для прода, например: openssl rand -hex 32
ADMIN_JWT_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_SECRET"

# Bootstrap-логика: npm run seed создаёт ОДНОГО superadmin-пользователя с этим
# логином/паролем, если пользователя с таким логином ещё нет в БД (идемпотентно).
# После первого входа в админку рекомендуется сменить пароль и/или завести
# отдельных именных админов через саму панель, а эти переменные из .env убрать.
ADMIN_BOOTSTRAP_LOGIN="admin"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_ME_WITH_A_STRONG_PASSWORD"

# Stars Payments (Этап 5, раздел 2.2 ТЗ) — VIP-подписка/косметика
# Секрет для межсервисного вызова bot -> backend после successful_payment
# (см. routes/internalRoutes.ts и bot/src/payments.ts). Сгенерировать так же,
# как ADMIN_JWT_SECRET: openssl rand -hex 32
INTERNAL_API_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_SECRET"

# Антифрод для рекламных наград (Этап 6, раздел 6 ТЗ) — минимальный интервал
# между claim'ами ОДНОГО игрока. hard = жёсткая блокировка (физически
# невозможно посмотреть ролик быстрее), soft = помечается suspicious для
# ручного разбора в админке ("Антифрод"), но награда всё равно выдаётся.
AD_ANTIFRAUD_HARD_MIN_SECONDS=3
AD_ANTIFRAUD_SOFT_MIN_SECONDS=10
